{
  "name": "dash_tvlwc",
  "version": "0.1.4a",
  "description": "Dash Component for Tradingview Lightweight Charts",
  "repository": {
    "type": "git",
    "url": "git://github.com/github.com/tysonwu/dash-tvlwc.git"
  },
  "bugs": {
    "url": "https://github.com/github.com/tysonwu/dash-tvlwc/issues"
  },
  "homepage": "https://github.com/github.com/tysonwu/dash-tvlwc",
  "main": "build/index.js",
  "scripts": {
    "start": "webpack-serve --config ./webpack.serve.config.js --open",
    "validate-init": "python _validate_init.py",
    "prepublishOnly": "npm run validate-init",
    "build:js": "webpack --mode production",
    "build:backends": "dash-generate-components ./src/lib/components dash_tvlwc -p package-info.json --r-prefix '' --jl-prefix '' --ignore \\.test\\.",
    "build:backends-activated": "(. venv/bin/activate || venv\\scripts\\activate && npm run build:py_and_r)",
    "build": "npm run build:js && npm run build:backends",
    "build:activated": "npm run build:js && npm run build:backends-activated"
  },
  "author": "Kwan Yu, WU <wukwanyutyson@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "lightweight-charts": "^5.0.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.8",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/eslint-parser": "^7.25.8",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.25.8",
    "@babel/preset-react": "^7.25.7",
    "eslint-plugin-react-hooks": "^4.6.0",
    "@plotly/dash-component-plugins": "^1.2.3",
    "@plotly/webpack-dash-dynamic-import": "^1.3.0",
    "babel-loader": "^9.2.1",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.8.1",
    "es-check": "^7.1.1",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "identity-obj-proxy": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "react-docgen": "^4.1.1",
    "react-dom": "^18.3.1",
    "react-jsx-parser": "^2.4.0",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "styled-jsx": "^5.1.7",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=8.11.0",
    "npm": ">=6.1.0"
  }
}
